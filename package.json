{
  "name": "dropkit",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A plugin for Figma that builds a design from a JSON file.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "site": "node scripts/build-site.mjs",
    "release": "npm run build && node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run typecheck && node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.141.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "marked": "18.0.14",
    "typescript": "~5.9.3"
  }
}
